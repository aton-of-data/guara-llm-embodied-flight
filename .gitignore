# Upstream clones are recreated by scripts/fetch_third_party.sh
third_party/*
!third_party/VERSIONS.md

# colcon
build/
install/
log/

# Python packaging (M17 `pip install -e .`)
*.egg-info/
dist/
.requirements.in

.DS_Store
.claude/settings.local.json

# Credentials for the evaluation harness. ADR 0013 decision 7: the key lives here and the
# harness records only the name of the variable it read, never the value.
.env

# SITL run artifacts (ULog, process logs, PX4 working directory) are large and stay local. The
# evidence a reviewer needs off this machine is published into docs/evidence/ by
# scripts/publish_evidence.py (review of 2026-09-11: "results/ is gitignored, so evidence cannot be
# reviewed off this machine").
results/*
!results/README.md

# Ogma generation scratch (committed outputs live in guara_monitors/generated/)
ros2_ws/src/guara_monitors/.ogma_out/
__pycache__/

# Figures the site displays are copied from docs/assets by scripts/sync_site_assets.sh
site/assets/*.png
site/assets/*.svg
