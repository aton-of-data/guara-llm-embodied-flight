@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/guara_coreTargets.cmake")

if(NOT TARGET guara::core)
  set(${CMAKE_FIND_PACKAGE_NAME}_FOUND FALSE)
  set(${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE
    "exported target guara::core is missing")
  return()
endif()

check_required_components(guara_core)
