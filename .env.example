# SPDX-License-Identifier: Apache-2.0
# Local credentials for the LLM evaluation harness (ADR 0013 decision 7).
# Copy to .env (git-ignored) and fill in. The harness records only the variable
# name, never the value. Instruments never fly.
#
# CURSOR_API_KEY is a user API key from https://cursor.com/dashboard/api
# used as a *hosted instrument* to generate Mission Intents. It is not a
# runtime dependency of a flight.

CURSOR_API_KEY=
