# SPDX-License-Identifier: Apache-2.0
# Local credentials for the LLM evaluation harness (ADR 0013 decision 7).
# Copy to .env (git-ignored) and fill in. The harness records only the variable
# name, never the value. Instruments never fly.
#
# CURSOR_API_KEY is a user API key from https://cursor.com/dashboard/api
# used as a *hosted instrument* to generate Mission Intents. It is not a
# runtime dependency of a flight.

CURSOR_API_KEY=

# OPENAI_API_KEY is used by the `openai-compat` provider, which also talks to any
# server implementing the same route. Point it elsewhere with GUARA_OPENAI_BASE_URL
# (e.g. http://localhost:8000/v1 for vLLM); a server needing no key still needs this
# variable set to any non-empty placeholder.

OPENAI_API_KEY=

# The `ollama` provider needs no credential at all. OLLAMA_HOST only moves it off
# localhost:11434.

OLLAMA_HOST=
