# SPDX-License-Identifier: Apache-2.0
#
# Single source of every version pin (M17 / AC-52, gap G-S2).
# Dockerfiles, fetch_third_party.sh, the lockfile generator and
# scripts/check_reproducible.py --pins read this file. Do not duplicate these
# values elsewhere: the --pins check fails on drift.
#
# This file is valid POSIX shell (KEY=VALUE, comments with #) so it can be
# sourced by the fetch script. Quotes are optional; the parser strips them.

# --- hosts ---
ROS2_DISTRO=humble
ROS2_BASE_IMAGE=ros:humble-ros-base-jammy
FM_BASE_IMAGE=ubuntu:22.04

PX4_REMOTE=https://github.com/PX4/PX4-Autopilot.git
PX4_REF=v1.17.0
PX4_COMMIT=d6f12ad1c4f70ad3230afd7d86e971421e02fef4

PX4_MSGS_REMOTE=https://github.com/PX4/px4_msgs.git
PX4_MSGS_REF=release/1.17
PX4_MSGS_COMMIT=86d8239e962f6939e05c3737784f60c02fa884db

PX4_ROS2_INTERFACE_LIB_REMOTE=https://github.com/Auterion/px4-ros2-interface-lib.git
PX4_ROS2_INTERFACE_LIB_REF=release/1.17
PX4_ROS2_INTERFACE_LIB_COMMIT=4a3370f084ac6f1ef001a4afa2b007845ffd0837

XRCE_AGENT_REMOTE=https://github.com/eProsima/Micro-XRCE-DDS-Agent.git
XRCE_AGENT_REF=v2.4.3

OGMA_REMOTE=https://github.com/nasa/ogma.git
OGMA_REF=v1.15.0
OGMA_COMMIT=69485b3442d76c48faaee30b37f9cbee212ceca6

COPILOT_REMOTE=https://github.com/Copilot-Language/copilot.git
COPILOT_REF=v4.8.1
COPILOT_COMMIT=365fb21429aa0b880f81d72dcaa9f207f5ea2d0a

FRET_REMOTE=https://github.com/NASA-SW-VnV/fret.git
FRET_REF=v3.1.0
FRET_COMMIT=58db455be35182a015e607232d9f4e3c86731932

DAIDALUS_REMOTE=https://github.com/nasa/daidalus.git
DAIDALUS_REF=DAIDALUSv2.0.3a
DAIDALUS_COMMIT=0647596edb218f8e8c7731ff800396297bbace99

FPRIME_REMOTE=https://github.com/nasa/fprime.git
FPRIME_REF=v4.3.0
FPRIME_COMMIT=7d8f579f159d2f7c2d4984d92828575e37f87fa6

# Formal-methods image toolchain (docker/Dockerfile.fm). GHC 9.10 / cabal 3.12
# is the configuration exercised by Ogma's own ROS CI.
GHC_VERSION=9.10.1
CABAL_VERSION=3.12.1.0
NODE_MAJOR=20
PYTHON_VERSION=3.10

# Python runtime floors. Exact versions and hashes are in requirements.lock
# (AC-52 / G-S1), generated on CPython $PYTHON_VERSION by scripts/lock_python.sh.
# Each value is a full pip requirement line.
PY_PYYAML=PyYAML>=6.0
PY_JSONSCHEMA=jsonschema>=4.0
PY_PYTEST=pytest>=7.0
PY_PYULOG=pyulog>=1.0
