<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>guara_monitors</name>
  <version>0.2.0</version>
  <description>Ogma/Copilot runtime monitors for Guará (ADR 0002). Generated C lives in generated/; the ROS node is hand-written so verdicts use guara_msgs/MonitorVerdict.</description>
  <maintainer email="dornfeld.in@gmail.com">aton-of-data</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>px4_msgs</depend>
  <depend>guara_msgs</depend>
  <depend>px4_ros2_cpp</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
